# MindLink — copy to .env.local and fill your keys
# Never commit .env.local

# Groq (text thinking + voice TTS) — https://console.groq.com
# Free tier available, no credit card required
GROQ_API_KEY=gsk_your_key_here

# Optional: OpenRouter (backup text / free TTS models)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Image generation: Pollinations is free (no key). 
# Optional Hugging Face for better quality:
# https://huggingface.co/settings/tokens
HF_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
